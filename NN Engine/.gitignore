# Build artifacts (machine-specific: -Ofast -march=native)
build/
*.so
*.o
*.html

# Cython-generated translation unit (regenerated from ChessAI.pyx on every build)
ChessAI.cpp

# Profiling
callgrind.out.*

# Loose run-output dumps
*.stderr
*.log

# Self-play & diagnostics RUN OUTPUT (reproducible, bulky).
# Harness code, openings, and the EPD suites stay tracked; the 3 crash.json
# replay fixtures are kept via `git add -f`.
selfplay/games/
selfplay/crashcheck/
diagnostics/results/
**/__pycache__/

# Generated Texel/tuning corpora (regenerable, bulky)
selfplay/tune_data/*corpus*.csv
selfplay/tune_data/smoke_cond.csv
selfplay/evalscreen.csv

# Diagnostics scratch / run-output (regenerable; the .py tools stay tracked).
# Underscore-prefixed csv/txt in diagnostics/ are per-run scratch; ks_sets/ fixtures
# WITHOUT a leading underscore (ks_archetypes.csv, game_regret_set*.csv, pawn_truth*.csv,
# sf11_static_labels.csv, lichess_ks*.csv, diverse_corpus_wide.csv) stay tracked.
diagnostics/*.out
diagnostics/*.err
diagnostics/*.tsv
diagnostics/*.fens
diagnostics/*.pgn
diagnostics/_*.csv
diagnostics/_*.txt
diagnostics/ks_sets/_*.csv
diagnostics/ks_sets/_*.txt

# Run-output dumps that escaped the underscore convention above (regenerable, bulky:
# corrlog_main.txt alone is 76 MB). The tools that WRITE them stay tracked.
diagnostics/corrlog_*.txt
selfplay/*.out
selfplay/tune_data/moves_*.csv
selfplay/tune_data/collapse_smoke.csv

# Corpora: WHITELIST. The fixtures the live tooling actually reads are tracked (added with
# `git add -f`, so these rules do not affect them); everything else here is a per-run dump, a
# stale pre-symmetry-sweep snapshot (*_pre0806*, *_preship*) or a one-off variant, and is
# regenerable. ⚠️ If you add a corpus a tool reads BY DEFAULT, `git add -f` it -- otherwise no
# result measured on it is reproducible on another machine.
diagnostics/ks_sets/*.csv
diagnostics/*.csv
