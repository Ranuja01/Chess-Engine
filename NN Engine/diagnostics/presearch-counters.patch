+// Pre-search node/move cost split by whether the root move already had a real score from the previous
+// iteration. Cross-tabbed against the call class and the previous table's length, because a SHORT previous
+// table has two very different causes -- an aspiration fail-high stump, and a legitimate root-razor break --
+// and only the cross-tab separates them. Cumulative across the run; read the LAST printed line, never a sum.
+enum AspCallClass { ASP_FIRST = 0, ASP_RETRY = 1, ASP_FALLBACK = 2, ASP_CLASS_N = 3 };
+static int g_asp_call_class = ASP_FIRST;
+// [class][prev_len_bucket] where bucket = 0:empty 1:(1-2) 2:(3-7) 3:(8+)
+static long g_pre_prefix_nodes[ASP_CLASS_N][4] = {};
+static long g_pre_tail_nodes[ASP_CLASS_N][4] = {};
+static long g_pre_prefix_moves[ASP_CLASS_N][4] = {};
+static long g_pre_tail_moves[ASP_CLASS_N][4] = {};
+static long g_pre_calls[ASP_CLASS_N][4] = {};
+// Tail length (root moves with no previous-iteration entry) -- bounds how much pre-search must keep running.
+static long g_pre_taillen_sum = 0;
+static long g_pre_rootlen_sum = 0;
+
+// Phase of the position at the current root call, set once per alpha_beta entry. Declared here because the
+// pre-search attribution below reads it; the bucket helper itself lives with the root-consume counters.
+// 0 = opening/middlegame (phase_score <= 62), 1 = endgame (63-96), 2 = advanced endgame (>96).
+static int g_root_phase = 0;
+static long g_pre_prefix_nodes_ph[3] = {};
+static long g_pre_tail_nodes_ph[3] = {};
+
+inline int asp_prev_len_bucket(size_t n)
+{
+    if (n == 0) return 0;
+    if (n <= 2) return 1;
+    if (n <= 7) return 2;
+    return 3;
+}
+
+/*
+    Charges pre-search nodes to the prefix (this root move already had a real score from the previous
+    iteration) or the tail (it did not -- razored away, or never reached). The prefix share is the ceiling on
+    what a subset pre-search could ever save; the tail is the population that must keep being pre-searched.
+
+    Parameters:
+        move_index - index into moves_list
+        prev_len   - previous_search_data.scores.size() for this call
+        nodes      - node delta attributable to this move's pre-search work
+*/
+inline void presearch_attribute_nodes(size_t move_index, size_t prev_len, long nodes)
+{
+    int b = asp_prev_len_bucket(prev_len);
+    int c = g_asp_call_class;
+    if (move_index < prev_len)
+    {
+        g_pre_prefix_nodes[c][b] += nodes;
+        g_pre_prefix_nodes_ph[g_root_phase] += nodes;
+    }
+    else
+    {
+        g_pre_tail_nodes[c][b] += nodes;
+        g_pre_tail_nodes_ph[g_root_phase] += nodes;
+    }
+}
+
+// ===================== root-loop consumption =====================
+// The pre-search scores EVERY root move, but the main root loop reads only the moves it gets through before
+// it stops. Any pre-search score beyond that point is never read at all -- not recomputation, pure waste.
+// These size that directly, and record whether the move finally chosen lay inside the previous iteration's
+// reusable prefix (if it nearly always does, ordering the tail matters little and it can be generated lazily).
+static long g_root_calls = 0;
+static long g_root_moves_total = 0;
+static long g_root_moves_searched = 0;
+static long g_root_prefix_len_sum = 0;
+static long g_root_best_in_prefix = 0;
+static long g_root_best_outside_prefix = 0;
+static long g_root_consumed_hist[6] = {};   // % of the root list consumed: <10, <25, <50, <75, <100, =100
+// Deep iterations only (depth_limit >= 10) -- the regime actually observed in play; the all-calls figures
+// are dragged down by shallow iterations and aspiration retries.
+static long g_root_deep_calls = 0;
+static long g_root_deep_moves_total = 0;
+static long g_root_deep_moves_searched = 0;
+static long g_root_deep_prefix_len_sum = 0;
+static long g_root_deep_best_in_prefix = 0;
+static long g_root_deep_best_outside_prefix = 0;
+
+// Phase-split, because root width and cutoff behaviour differ sharply between a 40-move middlegame and a
+// 12-move endgame -- an aggregate over both would hide exactly the comparison we want.
+// Buckets follow move_gen's own phase_score thresholds: 0 = opening/middlegame (<=62), 1 = endgame (63-96),
+// 2 = advanced endgame (>96). Second index: 0 = all calls, 1 = deep only (depth_limit >= 10).
+static long g_rc_calls[3][2] = {};
+static long g_rc_total[3][2] = {};
+static long g_rc_searched[3][2] = {};
+static long g_rc_prefix[3][2] = {};
+static long g_rc_best_in[3][2] = {};
+static long g_rc_best_out[3][2] = {};
+
+// Sufficiency of the previously-scored root prefix ("list 1") and the accuracy of the ordering it feeds.
+// Cross-tabbed by aspiration call class, because a retry is fed whatever the FAILED attempt left rather
+// than the last completed iteration's table -- the two must never be averaged. Second index: 0 = all
+// calls, 1 = deep only (depth_limit >= 10). Calls with no incoming table are counted apart, since
+// "stayed within the prefix" is undefined when the prefix is empty.
+static long g_l1_calls[ASP_CLASS_N][2] = {};
+static long g_l1_noprev[ASP_CLASS_N][2] = {};
+static long g_l1_within[ASP_CLASS_N][2] = {};
+static long g_l1_over_sum[ASP_CLASS_N][2] = {};
+static long g_l1_head_calls[ASP_CLASS_N][2] = {};
+static long g_l1_head_kept[ASP_CLASS_N][2] = {};
+// Absolute levels, without which "stayed within the prefix" is ambiguous: a one-entry prefix matched by a
+// one-move search satisfies it as readily as a healthy table does.
+static long g_l1_prevlen_sum[ASP_CLASS_N][2] = {};
+static long g_l1_searched_sum[ASP_CLASS_N][2] = {};
+// How far past the prefix edge the root loop runs, deep calls only: 0,1,2,3,4,5-7,8-15,16+.
+// This sizes a chunked widening step: the chunk only pays if it covers the bulk of this distribution.
+static long g_l1_over_hist[8] = {};
+
+inline void record_list_split(size_t searched_moves, size_t prev_len, bool has_fed_head,
+                              bool head_kept, int depth_limit)
+{
+    int c = g_asp_call_class;
+    if (c < 0 || c >= ASP_CLASS_N)
+        return;
+
+    long over = (searched_moves > prev_len) ? static_cast<long>(searched_moves - prev_len) : 0;
+    for (int d = 0; d < 2; ++d)
+    {
+        if (d == 1 && depth_limit < 10) continue;
+        if (prev_len == 0)
+        {
+            ++g_l1_noprev[c][d];
+            continue;
+        }
+        ++g_l1_calls[c][d];
+        if (over == 0) ++g_l1_within[c][d];
+        g_l1_over_sum[c][d] += over;
+        g_l1_prevlen_sum[c][d] += static_cast<long>(prev_len);
+        g_l1_searched_sum[c][d] += static_cast<long>(searched_moves);
+        if (has_fed_head)
+        {
+            ++g_l1_head_calls[c][d];
+            if (head_kept) ++g_l1_head_kept[c][d];
+        }
+    }
+    if (depth_limit >= 10 && prev_len > 0)
+        ++g_l1_over_hist[(over <= 4) ? static_cast<int>(over) : (over <= 7) ? 5 : (over <= 15) ? 6 : 7];
+}
+inline int root_phase_bucket(const BoardState &s)
+{
+    int phase = 4 * __builtin_popcountll(s.queens)
+              + 2 * __builtin_popcountll(s.rooks)
+              + __builtin_popcountll(s.bishops | s.knights);
+    int phase_score = 128 * (MAX_PHASE - phase) / MAX_PHASE;
+    return (phase_score <= 62) ? 0 : (phase_score <= 96) ? 1 : 2;
+}
+
+inline void record_root_consumption(size_t total_moves, size_t searched_moves, size_t prev_len,
+                                    int best_index, int depth_limit)
+{
+    if (total_moves == 0)
+        return;
+
+    {
+        int ph = g_root_phase;
+        bool in_pfx = (best_index >= 0 && (size_t)best_index < prev_len);
+        for (int d = 0; d < 2; ++d)
+        {
+            if (d == 1 && depth_limit < 10) continue;
+            ++g_rc_calls[ph][d];
+            g_rc_total[ph][d] += (long)total_moves;
+            g_rc_searched[ph][d] += (long)searched_moves;
+            g_rc_prefix[ph][d] += (long)prev_len;
+            if (best_index >= 0)
+            {
+                if (in_pfx) ++g_rc_best_in[ph][d]; else ++g_rc_best_out[ph][d];
+            }
+        }
+    }
+
+    ++g_root_calls;
+    g_root_moves_total += (long)total_moves;
+    g_root_moves_searched += (long)searched_moves;
+    g_root_prefix_len_sum += (long)prev_len;
+
+    int pct = (int)((100 * searched_moves) / total_moves);
+    int b = (pct < 10) ? 0 : (pct < 25) ? 1 : (pct < 50) ? 2 : (pct < 75) ? 3 : (pct < 100) ? 4 : 5;
+    ++g_root_consumed_hist[b];
+
+    bool in_prefix = (best_index >= 0 && (size_t)best_index < prev_len);
+    if (best_index >= 0)
+    {
+        if (in_prefix) ++g_root_best_in_prefix; else ++g_root_best_outside_prefix;
+    }
+
+    if (depth_limit >= 10)
+    {
+        ++g_root_deep_calls;
+        g_root_deep_moves_total += (long)total_moves;
+        g_root_deep_moves_searched += (long)searched_moves;
+        g_root_deep_prefix_len_sum += (long)prev_len;
+        if (best_index >= 0)
+        {
+            if (in_prefix) ++g_root_deep_best_in_prefix; else ++g_root_deep_best_outside_prefix;
+        }
+    }
+}
+
+/*
+    Records root-loop consumption on EVERY exit path. alpha_beta returns from four places (root beta cutoff,
+    two time-limit checks, and the normal end), so a scope guard is used rather than instrumenting each site
+    -- a missed return would silently bias the numbers toward the completed case.
+*/
+struct RootConsumeGuard
+{
+    const SearchData &cur;
+    const SearchData &prev;
+    const int &best_index;
+    size_t prev_len;
+    int depth_limit;
+    // Head of the table this call was FED, captured before the root loop clears it. Comparing it against
+    // the move finally chosen measures how often the incoming ordering's first candidate was already right.
+    Move fed_head;
+    bool has_fed_head;
+    ~RootConsumeGuard()
+    {
+        record_root_consumption(cur.moves_list.size(), prev.scores.size(), prev_len, best_index, depth_limit);
+
+        bool head_kept = has_fed_head
+                         && best_index >= 0
+                         && static_cast<size_t>(best_index) < cur.moves_list.size()
+                         && cur.moves_list[best_index].from_square == fed_head.from_square
+                         && cur.moves_list[best_index].to_square == fed_head.to_square
+                         && cur.moves_list[best_index].promotion == fed_head.promotion;
+        record_list_split(prev.scores.size(), prev_len, has_fed_head, head_kept, depth_limit);
+    }
+};
+
